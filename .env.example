# Copie para .env (ou .env.local) e preencha. NUNCA reutilize valores do projeto de produção
# (sistema-de-gestao-tecnica / central-operacional) — banco, blob, chaves e instâncias devem ser novos.

# Banco (Neon Postgres) — banco PRÓPRIO deste projeto
DATABASE_URL=
# Opcional: papel com permissão de alterar o schema, usado só por `pnpm db:migrate` (sem ele, usa DATABASE_URL)
DATABASE_MIGRATION_URL=

# Auth — gere um valor novo e longo (ex.: `openssl rand -base64 48`). Obrigatório: o app não sobe sem ele.
JWT_SECRET=

# Vercel Blob (biblioteca de documentos)
BLOB_READ_WRITE_TOKEN=
# Vercel account token (Account Settings → Tokens), read-only use: detects the plan for the Blob capacity.
# VERCEL_TEAM_ID only when the token reaches more than one team.
VERCEL_API_TOKEN=
VERCEL_TEAM_ID=

# Integração Porto Seguro — chave que criptografa as credenciais do Porto salvas no banco
PORTO_CREDENTIALS_KEY=

# Worker da VPS (automação Porto + WhatsApp). Container `nextrotta-worker`, porta 8091 (a 8090 é do
# worker do sistema original, na mesma VPS), publicado pelo Caddy em /nextrotta-worker/*.
# Ex.: PORTO_WORKER_URL=https://evolution-whatsapp.duckdns.org/nextrotta-worker
PORTO_WORKER_URL=
PORTO_WORKER_SECRET=
PORTO_WORKER_PORT=8091

# Agente da VPS (painel do dono → Operação → VPS: métricas, containers, limpeza). Container
# `nextrotta-vps-agent`, porta 8092, publicado pelo Caddy em /nextrotta-vps-agent/*. Segredo próprio,
# diferente do worker. Configure no app (Vercel) e no worker (que coleta as métricas a cada 5 min).
VPS_AGENT_URL=
VPS_AGENT_SECRET=

# WhatsApp (Evolution API) — o SERVIDOR, compartilhado por todas as organizações. Nunca aparece em
# nenhuma tela. Cada organização cria a própria instância (nome = subdomínio) na tela WhatsApp.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=

# Domínio raiz — organizações ficam em <slug>.ROOT_DOMAIN. Em produção: nextrotta.com.br.
# Em desenvolvimento deixe vazio: o padrão é nextrotta.localhost:3000 (não use "localhost" puro, causa loop de redirecionamento).
ROOT_DOMAIN=

# Cobrança — Asaas. ASAAS_ENVIRONMENT=production usa a API real; qualquer outro valor usa o sandbox.
# A chave começa com "$": grave sem aspas e escapada com "\$" (ASAAS_API_KEY=\$aact_...), senão o Next a expande como variável e ela chega vazia.
ASAAS_API_KEY=
ASAAS_ENVIRONMENT=sandbox
# Só para split de pagamentos (não usado pela assinatura)
ASAAS_WALLET_ID=
# Token que o Asaas envia no cabeçalho asaas-access-token dos webhooks (o mesmo valor configurado no painel do Asaas)
ASAAS_WEBHOOK_TOKEN=

# Controle de Peças — Mercado Pago (docs/controle-de-pecas.md). Um aplicativo da plataforma no Mercado Pago
# Developers; cada técnico autoriza esse aplicativo na própria conta (OAuth) e as vendas caem na conta dele.
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
# Chave que cifra os tokens dos técnicos no banco (32 bytes em base64): openssl rand -base64 32
MERCADOPAGO_TOKEN_KEY=
# "Assinatura secreta" dos webhooks do aplicativo (valida o x-signature)
MERCADOPAGO_WEBHOOK_SECRET=
# Opcionais. Padrões: https://<ROOT_DOMAIN>/api/mercadopago/oauth/callback e https://<ROOT_DOMAIN>/api/webhooks/mercadopago
MERCADOPAGO_REDIRECT_URI=
MERCADOPAGO_WEBHOOK_URL=
# E-mail de pagador usado no Pix quando a venda não tem o do cliente (padrão: pagador@<ROOT_DOMAIN>)
MERCADOPAGO_FALLBACK_PAYER_EMAIL=

# IA — DeepSeek, consumida com créditos por organização (previsto, ainda não integrado)
DEEPSEEK_API_KEY=
